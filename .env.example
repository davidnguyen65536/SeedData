# Copy this file to .env and fill in what you need. .env is git-ignored: never commit it.
# Nothing here is needed for the core app (NASA POWER and MODIS need no login).

# Optional: SMAP soil moisture and SRTM slope via NASA AppEEARS
# Free account: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional: SILO rainfall check (SILO uses your email address as the API username)
SILO_EMAIL=

# Optional, hosting only: AI wording for "Why this score?"
# Set these in the hosting dashboard (e.g. Vercel > Settings > Environment Variables), not here.
# ANTHROPIC_API_KEY=
# MODEL=claude-sonnet-5-5
# ALLOWED_ORIGIN=https://your-app.vercel.app
